# ──────────────────────────────────────────────────────────────────────────────
# ScholarSphere environment configuration
#
# All values below are PUBLIC and are bundled into the browser app.
# NEVER put secrets in this file (or in any VITE_* variable).
# ──────────────────────────────────────────────────────────────────────────────

# Base URL of a real backend API. Leave EMPTY to use the in-browser mock API.
# When set, the app transparently swaps MockApiClient for FetchApiClient.
VITE_API_BASE_URL=

# Simulated network latency for the mock API ("true" | "false").
VITE_MOCK_LATENCY=true

# Show demo-mode labels/disclaimers ("true" | "false").
VITE_DEMO_MODE=true
